{
  "name": "panhub",
  "version": "0.1.0",
  "description": "跨平台网盘聚合下载器 —— 一次登录，50+ 网盘统一下载",
  "main": "./out/main/index.cjs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --config.electronDist=node_modules/electron/dist",
    "dist:mac": "electron-vite build && electron-builder --mac --config.electronDist=node_modules/electron/dist",
    "dist:linux": "electron-vite build && electron-builder --linux --config.electronDist=node_modules/electron/dist",
    "test": "node --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "dist:ci": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "author": {
    "name": "llllishuo",
    "email": "1756524586@qq.com"
  }
}
